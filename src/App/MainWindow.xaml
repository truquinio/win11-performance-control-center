<Window x:Class="Win11PerformanceControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Win11 Performance Control Center"
        Icon="Assets/app-icon.png"
        Width="1440" Height="780"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        Background="#061321">
<shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="6"
                        CornerRadius="12"
                        GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#07192B"
            BorderBrush="#17456B"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="46"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0">
          <Image Source="Assets/app-icon.png"
                 Width="24"
                 Height="24"
                 Stretch="Uniform"
                 Margin="0,0,9,0"/>
          <TextBlock Text="Win11 Performance Control Center"
                     Foreground="#F4F8FF"
                     FontWeight="SemiBold"
                     FontSize="14"
                     VerticalAlignment="Center"/>
          <TextBlock Text="  v0.1.0  ·  by truquinio"
                     Foreground="#8EA5BA"
                     FontSize="11"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <Border x:Name="TitleStateBadge"
                Grid.Column="1"
                Margin="0,7,8,7"
                Padding="10,0"
                CornerRadius="10"
                BorderBrush="#176F4B"
                BorderThickness="1"
                Background="#0D563A">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Ellipse x:Name="TitleStateDot"
                     Width="7"
                     Height="7"
                     Fill="#4BF49A"
                     Margin="0,0,6,0"/>
            <TextBlock x:Name="TitleStateText"
                       Text="Estado: IDLE"
                       Foreground="#4BF49A"
                       FontSize="10"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Margin="0,7,10,7"
                Padding="10,0"
                CornerRadius="10"
                BorderBrush="#174B70"
                BorderThickness="1"
                Background="#0A2943">
          <TextBlock Text="OFFLINE-FIRST"
                     Foreground="#32C7FF"
                     FontSize="10"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </Border>

        <Button Grid.Column="3"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Minimize_Click"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#BFD0E0"
                FontSize="16"
                Content="—"/>
        <Button Grid.Column="4"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="MaximizeRestore_Click"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#BFD0E0"
                FontSize="14"
                Content="□"/>
        <Button Grid.Column="5"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="Close_Click"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#BFD0E0"
                FontSize="17"
                Content="×"/>
      </Grid>
    </Border>

    <wv2:WebView2 Grid.Row="1"
                  x:Name="WebView"
                  DefaultBackgroundColor="#071426" />
  </Grid>
</Window>
