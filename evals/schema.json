{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WPCC real-world regression scenario",
  "type": "object",
  "required": [
    "id",
    "kind",
    "description",
    "targetRelativePath",
    "processRunning",
    "expectedDeletedFiles",
    "expectedFailedFiles",
    "runTwice",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "targetRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "processName": {
      "type": [
        "string",
        "null"
      ]
    },
    "processRunning": {
      "type": "boolean"
    },
    "expectedDeletedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "expectedFailedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "expectedSkippedCategories": {
      "type": "integer",
      "minimum": 0
    },
    "runTwice": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "ageDays",
          "sizeBytes",
          "expect"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ageDays": {
            "type": "integer",
            "minimum": 0
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "expect": {
            "enum": [
              "deleted",
              "preserved"
            ]
          }
        }
      }
    }
  }
}
